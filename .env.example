# Copy to .env for local Docker Compose. Replace all secrets before production.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgresql://insightflow:local-development-only@db:5432/insightflow
POSTGRES_DB=insightflow
POSTGRES_USER=insightflow
POSTGRES_PASSWORD=local-development-only-change-me
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
MAX_UPLOAD_BYTES=10485760
MEDIA_ROOT=/app/private_uploads
VITE_API_URL=http://localhost:8000/api/v1/
